{
  "name": "cogni-ia",
  "version": "0.1.0",
  "private": true,
  "description": "COGNI IA - plataforma de estudos com IA para ENEM e vestibulares",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "seed:biblioteca": "node scripts/seed-biblioteca.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.5.2",
    "@supabase/supabase-js": "2.45.6",
    "clsx": "2.1.1",
    "lucide-react": "0.451.0",
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.0.1",
    "remark-gfm": "4.0.0",
    "tailwind-merge": "2.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "@tailwindcss/typography": "0.5.15",
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@vitest/coverage-v8": "2.1.9",
    "autoprefixer": "10.4.20",
    "dotenv": "16.4.5",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "8.4.47",
    "prettier": "3.3.3",
    "tailwindcss": "3.4.13",
    "typescript": "5.6.3",
    "vite-tsconfig-paths": "5.0.1",
    "vitest": "2.1.9"
  }
}
